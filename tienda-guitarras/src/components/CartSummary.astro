---
interface Props {
    cantidad: number;
    total: number;
}

const {cantidad, total} = Astro.props;
---

<aside class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <h2 class="text-xl font-bold">🛒 Resumen del carrito</h2>

    <p class="mt-3 text-gray-600">
        Productos: {cantidad}
    </p>

    <p class="mt-2 text-lg font-black text-orange-600">
        Total: ${total.toLocaleString("es-MX")} MXN
    </p>

    <button
            type="button"
            class="mt-4 w-full rounded-lg bg-gray-900 px-4 py-3 font-bold text-white"
    >
        Continuar
    </button>
</aside>
