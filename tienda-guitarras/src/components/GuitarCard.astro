---
interface Props {
    nombre: string;
    precio: number;
    imagen: string;
    descripcion: string;
}

const {nombre, precio, imagen, descripcion} =
    Astro.props;
---

<article
        class="grid grid-cols-1 gap-5 rounded-xl border border-gray-200 p-5 shadow-sm
        transition hover:shadow-lg sm:grid-cols-[140px_1fr]"
>
    <img
            src={imagen}
            alt={`Guitarra ${nombre}`}
            class="mx-auto h-48 w-full object-contain"
            loading="lazy"
    />

    <div class="flex flex-col items-start">
        <h3 class="text-xl font-extrabold uppercase">
            {nombre}
        </h3>

        <p class="mt-2 text-sm leading-6 text-gray-600">
            {descripcion}
        </p>

        <p class="mt-4 text-2xl font-black text-orange-600">
            ${precio.toLocaleString("es-MX")} MXN
        </p>

        <button
                type="button"
                class="mt-4 w-full rounded-lg bg-gray-900 px-4 py-3 font-bold
                text-white hover:bg-orange-600"
        >
            Agregar al carrito
        </button>
    </div>
</article>
