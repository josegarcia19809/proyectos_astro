---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contacto">
    <section class="mx-auto max-w-xl">
        <h1 class="text-4xl font-black">Contáctanos</h1>

        <p class="mt-3 text-gray-600">
            ¿Tienes dudas sobre alguna guitarra? Escríbenos.
        </p>

        <form class="mt-8 space-y-5">
            <div>
                <label for="nombre" class="mb-2 block font-semibold">
                    Nombre
                </label>
                <input
                        id="nombre"
                        name="nombre"
                        required
                        class="w-full rounded-lg border border-gray-300 p-3
                        focus:border-orange-600 focus:outline-none"
                />
            </div>

            <div>
                <label for="correo" class="mb-2 block font-semibold">
                    Correo electrónico
                </label>
                <input
                        id="correo"
                        name="correo"
                        type="email"
                        required
                        class="w-full rounded-lg border border-gray-300 p-3
                        focus:border-orange-600 focus:outline-none"
                />
            </div>

            <div>
                <label for="mensaje" class="mb-2 block font-semibold">
                    Mensaje
                </label>
                <textarea
                        id="mensaje"
                        name="mensaje"
                        rows="4"
                        required
                        class="w-full rounded-lg border border-gray-300 p-3
                        focus:border-orange-600 focus:outline-none"
                ></textarea>
            </div>

            <button
                    type="submit"
                    class="w-full rounded-lg bg-gray-900 p-3 font-bold text-white
                    hover:bg-orange-600"
            >
                Enviar mensaje
            </button>
        </form>
    </section>
</MainLayout>
