---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Nosotros">
    <section class="mx-auto max-w-3xl">
        <h1 class="text-4xl font-black">Sobre GuitarLA</h1>

        <p class="mt-5 leading-8 text-gray-600">
            Somos una tienda dedicada a los músicos. Nuestro
            objetivo es ayudarte a encontrar instrumentos
            adecuados para tu estilo y experiencia.
        </p>

        <h2 class="mt-8 text-2xl font-bold">Nuestra misión</h2>
        <p class="mt-3 leading-7 text-gray-600">
            Acercar la música a más personas mediante una
            colección de guitarras para diferentes necesidades.
        </p>
    </section>
</MainLayout>
