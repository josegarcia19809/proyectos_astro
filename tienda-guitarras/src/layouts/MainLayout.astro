---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {title = "GuitarLA"} = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="description" content="Tienda de guitarras GuitarLA"/>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
    />
    <link
            href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Playwrite+AR:wght@100..400&display=swap"
            rel="stylesheet"
    />
    <title>{title} | GuitarLA</title>
</head>

<body class="bg-white text-gray-900">
<Header/>

<main class="mx-auto min-h-screen max-w-7xl px-6 py-10">
    <slot/>
</main>

<Footer/>
</body>
</html>
