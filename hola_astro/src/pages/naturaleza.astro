---
import '../styles/global.css';
---

<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Montañas</title>
</head>

<body class="min-h-screen bg-white flex items-center justify-center p-6">

    <main class="max-w-3xl w-full bg-blue-400 rounded-2xl shadow-xl overflow-hidden">

        <div class="p-8 text-center">

            <h1 class="text-4xl font-bold text-slate-800 mb-3">
                Montañas 🏔️
            </h1>

            <p class="text-slate-500 mb-6">
                Descubre la belleza de la naturaleza 🌲
            </p>

            <img
                src="/montania.jpg"
                alt="Paisaje de montañas"
                class="w-full h-96 object-cover rounded-xl border-4
                border-amber-400 shadow-lg"
            />

        </div>

    </main>

</body>
</html>