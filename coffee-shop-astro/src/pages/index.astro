---
import {Image} from "astro:assets"
import Layout from "../layouts/Layout.astro"
const nombre = "Jose"
import image from "../assets/bg_home.jpg"
---

<Layout>

    <h1 class="text-3xl">Hola Mundo en Astro {nombre}</h1>
    <a href="/nosotros">Ir a nosotros</a>
    <img src={image.src}/>
    <Image src={image} format="avif" alt="Imagen BG"/>
</Layout>
